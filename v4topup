/* ===================== PROMO POPUP ===================== */
function loadPromoPopupAdmin() {
    const data = JSON.parse(localStorage.getItem(dbPopupKey)) || {};
    document.getElementById('popup-enabled').checked = data.enabled !== false;
    document.getElementById('popup-title').value = data.title || '';
    document.getElementById('popup-desc').value = data.desc || '';
    document.getElementById('popup-img-data').value = data.img || '';
    document.getElementById('popup-btn1-label').value = data.btn1Label || '';
    document.getElementById('popup-btn1-link').value = data.btn1Link || '';
    document.getElementById('popup-btn2-label').value = data.btn2Label || '';
    document.getElementById('popup-btn2-link').value = data.btn2Link || '';
    const prev = document.getElementById('popup-img-preview');
    if (data.img) {
        prev.src = data.img;
        prev.classList.remove('hidden');
    } else {
        prev.classList.add('hidden');
    }
}

document.getElementById('popup-img-file')?.addEventListener('change', async function() {
    if (this.files[0]) {
        const b64 = await convertFileToBase64(this.files[0]);
        document.getElementById('popup-img-data').value = b64;
        const prev = document.getElementById('popup-img-preview');
        prev.src = b64;
        prev.classList.remove('hidden');
    }
});

async function simpanPromoPopup() {
    const data = {
        enabled: document.getElementById('popup-enabled').checked,
        title: document.getElementById('popup-title').value.trim() || 'Promo Spesial',
        desc: document.getElementById('popup-desc').value.trim(),
        img: document.getElementById('popup-img-data').value,
        btn1Label: document.getElementById('popup-btn1-label').value.trim(),
        btn1Link: document.getElementById('popup-btn1-link').value.trim(),
        btn2Label: document.getElementById('popup-btn2-label').value.trim(),
        btn2Link: document.getElementById('popup-btn2-link').value.trim()
    };
    localStorage.setItem(dbPopupKey, JSON.stringify(data));
    // Reset "jangan tampilkan lagi" agar popup bisa muncul lagi setelah admin update
    localStorage.removeItem(dbPopupHideKey);
    showSuccessModal('Popup Disimpan!', 'Popup promo akan muncul ke semua pengunjung saat membuka website.');
    closeModal('adminPopupModal');
}

function showPromoPopupIfNeeded() {
    const data = JSON.parse(localStorage.getItem(dbPopupKey));
    if (!data || !data.enabled || !data.img) return;
    if (localStorage.getItem(dbPopupHideKey) === '1') return;

    document.getElementById('promo-popup-img').src = data.img;
    document.getElementById('promo-popup-title').textContent = data.title || 'Promo Spesial';
    document.getElementById('promo-popup-desc').textContent = data.desc || '';

    const contacts = document.getElementById('promo-popup-contacts');
    contacts.innerHTML = '';
    if (data.btn1Label && data.btn1Link) {
        contacts.innerHTML += `<a href="${data.btn1Link}" target="_blank" class="block w-full bg-emerald-500/15 border border-emerald-500/40 text-emerald-500 font-bold py-2.5 rounded-xl text-xs"><i class="fab fa-whatsapp"></i> ${data.btn1Label}</a>`;
    }
    if (data.btn2Label && data.btn2Link) {
        contacts.innerHTML += `<a href="${data.btn2Link}" target="_blank" class="block w-full bg-sky-500/15 border border-sky-500/40 text-sky-500 font-bold py-2.5 rounded-xl text-xs"><i class="fab fa-whatsapp"></i> ${data.btn2Label}</a>`;
    }

    document.getElementById('promo-dont-show').checked = false;
    openModal('promoPopupModal');
}

function closePromoPopup(fromBtn) {
    if (document.getElementById('promo-dont-show').checked) {
        localStorage.setItem(dbPopupHideKey, '1');
    }
    closeModal('promoPopupModal');
}

// Patch openModal for popup admin
const _origOpenModal = openModal;
openModal = function(id) {
    _origOpenModal(id);
    if (id === 'adminPopupModal') loadPromoPopupAdmin();
};

/* ===================== INIT ===================== */
document.addEventListener('DOMContentLoaded', () => {
    renderAllData();
    const session = JSON.parse(localStorage.getItem(dbCurrentSessionKey));
    if (session) {
        const nameEl = document.getElementById('input-edit-name');
        const avEl = document.getElementById('preview-edit-avatar');
        if (nameEl) nameEl.value = session.username;
        if (avEl) avEl.src = session.avatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(session.username)}&background=random`;
    }
    // Tampilkan popup promo setelah sedikit delay
    setTimeout(showPromoPopupIfNeeded, 600);
});
</script>
