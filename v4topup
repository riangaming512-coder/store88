                ${t.status === 'pending' ? `
                    <button onclick="updateTrxStatus('${t.id}','success')" class="text-[9px] bg-emerald-500/20 text-emerald-500 px-2 py-1 rounded font-bold">Approve</button>
                    <button onclick="updateTrxStatus('${t.id}','rejected')" class="text-[9px] bg-red-500/20 text-red-500 px-2 py-1 rounded font-bold">Tolak</button>
