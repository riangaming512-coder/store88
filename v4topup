    let branding = JSON.parse(localStorage.getItem(dbStoreBrandingKey)) || { name: 'V4 TOPUP', logo: '' };
    let brandEl = document.getElementById('store-brand-title');
    let browserTitle = document.getElementById('page-browser-title');
    let logoIcon = document.getElementById('store-logo-icon');
    let logoImg = document.getElementById('store-logo-img');

    if (brandEl) {
        const n = (branding.name || 'V4 TOPUP').trim();
        const parts = n.split(/\s+/);
        let html;
        if (parts.length >= 2) {
            const last = parts.pop();
            html = `${parts.join(' ')} <span class="text-orange-500">${last}</span>`;
        } else if (n.length > 2) {
            html = `${n.slice(0, -2)}<span class="text-orange-500">${n.slice(-2)}</span>`;
        } else {
            html = `<span class="text-orange-500">${n}</span>`;
        }
        brandEl.innerHTML = `${html} <span class="bg-orange-500/20 border border-orange-500/40 text-[8px] text-orange-500 font-extrabold px-1.5 py-0.5 rounded">PRO</span>`;
    }
    if (browserTitle) browserTitle.innerText = `${branding.name || 'V4 TOPUP'} - Ultimate Game Top-Up & Digital Store`;

    if (branding.logo) {
        logoIcon.classList.add('hidden');
        logoImg.src = branding.logo;
        logoImg.classList.remove('hidden');
    } else {
        logoImg.classList.add('hidden');
        logoIcon.classList.remove('hidden');
    }
}
applyStoreBranding();

