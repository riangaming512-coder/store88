function updateTrxStatus(id, status) {
    let trans = JSON.parse(localStorage.getItem(dbTransKey)) || [];
    const idx = trans.findIndex(t => t.id === id);
    if (idx < 0) return;

    const t = trans[idx];
    t.status = status;

    // Jika deposit disetujui → tambah saldo user
    if (status === 'success' && t.type === 'deposit') {
        let users = JSON.parse(localStorage.getItem(dbUsersKey)) || [];
        const uIdx = users.findIndex(u => u.username === t.username);
        if (uIdx >= 0) {
            users[uIdx].balance = (users[uIdx].balance || 0) + t.priceNum;
            localStorage.setItem(dbUsersKey, JSON.stringify(users));

            // Update session jika sedang login sebagai user tersebut
            const session = JSON.parse(localStorage.getItem(dbCurrentSessionKey));
            if (session && session.username === t.username) {
                session.balance = users[uIdx].balance;
                localStorage.setItem(dbCurrentSessionKey, JSON.stringify(session));
            }
        }
    }

    // Starlight count on success topup
    if (status === 'success' && t.type === 'topup' && t.itemName.toLowerCase().includes('starlight')) {
        let users = JSON.parse(localStorage.getItem(dbUsersKey)) || [];
        const uIdx = users.findIndex(u => u.username === t.username);
        if (uIdx >= 0) {
            users[uIdx].starlightCount = (users[uIdx].starlightCount || 0) + 1;
            localStorage.setItem(dbUsersKey, JSON.stringify(users));
            const session = JSON.parse(localStorage.getItem(dbCurrentSessionKey));
            if (session && session.username === t.username) {
                session.starlightCount = users[uIdx].starlightCount;
                localStorage.setItem(dbCurrentSessionKey, JSON.stringify(session));
            }
        }
    }

    localStorage.setItem(dbTransKey, JSON.stringify(trans));
    showToast(`Transaksi ${id} → ${status}`);
    renderLaporanKasir();
}

function resetLaporanKasir() {
    if (!confirm('Yakin reset semua transaksi? Data tidak bisa dikembalikan.')) return;
    localStorage.setItem(dbTransKey, JSON.stringify([]));
