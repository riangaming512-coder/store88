async function simpanGame() {
    const id = document.getElementById('gameId').value || ('g' + Date.now());
    const title = document.getElementById('gameTitle').value.trim();
    const badge = document.getElementById('gameBadge').value.trim();
    const oldImg = document.getElementById('gameOldImg').value;
    const imgFile = document.getElementById('gameImg').files[0];

    let img = oldImg;
    if (imgFile) img = await convertFileToBase64(imgFile);
    if (!img) img = 'https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=400&auto=format&fit=crop';

    const items = [];
    document.querySelectorAll('#dynamic-items-container > div').forEach(row => {
        const name = row.querySelector('.item-name').value.trim();
        const price = row.querySelector('.item-price').value.trim();
        if (name && price) items.push({ name, price });
    });

    if (!title || items.length === 0) {
        showToast('Isi nama game dan minimal 1 item!');
        return;
    }

    let games = JSON.parse(localStorage.getItem(dbGamesKey)) || [];
    const existingIdx = games.findIndex(g => g.id === id);
    const gameData = { id, title, badge, img, items };

    if (existingIdx >= 0) games[existingIdx] = gameData;
    else games.push(gameData);

    localStorage.setItem(dbGamesKey, JSON.stringify(games));
    showToast('Game berhasil disimpan!');
    closeModal('adminGameModal');
    renderGames();
}

