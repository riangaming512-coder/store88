function switchView(viewId) {
    document.querySelectorAll('.app-view').forEach(v => v.classList.remove('active'));
    let target = document.getElementById('view-' + viewId);
    if (target) target.classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });

    if (viewId === 'home') renderAllData();
    if (viewId === 'kasir') {
        localStorage.setItem(dbNotifKey, 'false');
        hideAdminNotif();
        updateNotifUI();
        renderLaporanKasir();
    }
    if (viewId === 'member-history') renderGoPayHistory();
    if (viewId === 'spin-coa') { checkSpinEligibility(); drawSpinWheel(); }
    if (viewId === 'settings') updateSessionUI();
    if (viewId === 'member-wallet') updateSessionUI();
}

