/* ===================== SPIN WHEEL ===================== */
const spinPrizes = [
    { label: 'Rp 1.000', value: 1000, color: '#f59e0b' },
    { label: 'Rp 2.000', value: 2000, color: '#f97316' },
    { label: 'Rp 3.000', value: 3000, color: '#ef4444' },
    { label: 'Rp 5.000', value: 5000, color: '#8b5cf6' },
    { label: 'Rp 1.000', value: 1000, color: '#06b6d4' },
    { label: 'Rp 10.000', value: 10000, color: '#10b981' },
    { label: 'Rp 2.000', value: 2000, color: '#ec4899' },
    { label: 'Rp 1.000', value: 1000, color: '#6366f1' }
];

function drawSpinWheel() {
    const canvas = document.getElementById('wheelCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const cx = canvas.width / 2;
    const cy = canvas.height / 2;
    const r = canvas.width / 2 - 4;
    const n = spinPrizes.length;
    const arc = (2 * Math.PI) / n;

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    for (let i = 0; i < n; i++) {
        const start = i * arc - Math.PI / 2;
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, r, start, start + arc);
        ctx.closePath();
        ctx.fillStyle = spinPrizes[i].color;
        ctx.fill();
        ctx.strokeStyle = 'rgba(255,255,255,0.3)';
        ctx.lineWidth = 1;
        ctx.stroke();

        // Text
        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(start + arc / 2);
        ctx.textAlign = 'right';
        ctx.fillStyle = '#fff';
        ctx.font = 'bold 11px sans-serif';
        ctx.fillText(spinPrizes[i].label, r - 12, 4);
        ctx.restore();
    }

    // Center circle
    ctx.beginPath();
    ctx.arc(cx, cy, 28, 0, 2 * Math.PI);
    ctx.fillStyle = '#13151b';
    ctx.fill();
    ctx.strokeStyle = '#f59e0b';
    ctx.lineWidth = 3;
    ctx.stroke();
    ctx.fillStyle = '#f59e0b';
    ctx.font = 'bold 10px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('SPIN', cx, cy + 4);
}

function checkSpinEligibility() {
    const session = JSON.parse(localStorage.getItem(dbCurrentSessionKey));
    const progressText = document.getElementById('spin-progress-text');
    const progressBar = document.getElementById('spin-progress-bar');
    const statusNote = document.getElementById('spin-status-note');
    const spinBtn = document.getElementById('spin-button');

    const count = session ? (session.starlightCount || 0) : 0;
    const pct = Math.min(100, (count / 10) * 100);

    progressText.textContent = `${count} / 10 Starlight`;
    progressBar.style.width = pct + '%';

    if (count >= 10) {
        statusNote.innerHTML = '<i class="fas fa-unlock text-emerald-500"></i> <span class="text-emerald-500">Siap spin! Klik tombol di bawah.</span>';
        spinBtn.disabled = false;
    } else {
        statusNote.innerHTML = `<i class="fas fa-lock"></i> Beli item Starlight ${10 - count}x lagi untuk menyepin!`;
        spinBtn.disabled = true;
    }
}

function putarWheelCoA() {
    if (isSpinning) return;
    const session = JSON.parse(localStorage.getItem(dbCurrentSessionKey));
    if (!session || (session.starlightCount || 0) < 10) {
        showToast('Progress Starlight belum cukup!');
        return;
    }

    isSpinning = true;
    const btn = document.getElementById('spin-button');
    btn.disabled = true;

    const prizeIdx = Math.floor(Math.random() * spinPrizes.length);
    const n = spinPrizes.length;
    const arcDeg = 360 / n;
    // Stop so the prize lands at the top pointer
    const extraSpins = 5 + Math.floor(Math.random() * 3);
    const targetDeg = extraSpins * 360 + (360 - (prizeIdx * arcDeg + arcDeg / 2));

    const canvas = document.getElementById('wheelCanvas');
    canvas.style.transition = 'transform 4.5s cubic-bezier(0.15, 0.99, 0.18, 1)';
    canvas.style.transform = `rotate(${targetDeg}deg)`;

    setTimeout(() => {
        const prize = spinPrizes[prizeIdx];
        // Add to balance
        let users = JSON.parse(localStorage.getItem(dbUsersKey)) || [];
        const uIdx = users.findIndex(u => u.username === session.username);
        if (uIdx >= 0) {
            users[uIdx].balance = (users[uIdx].balance || 0) + prize.value;
            users[uIdx].starlightCount = 0; // reset progress after spin
            localStorage.setItem(dbUsersKey, JSON.stringify(users));
            session.balance = users[uIdx].balance;
            session.starlightCount = 0;
            localStorage.setItem(dbCurrentSessionKey, JSON.stringify(session));
        }

        showToast(`🎉 Selamat! Kamu menang ${prize.label}! Saldo ditambahkan.`);
        isSpinning = false;
        canvas.style.transition = 'none';
        canvas.style.transform = `rotate(${targetDeg % 360}deg)`;
        checkSpinEligibility();
        updateSessionUI();
    }, 4600);
}

