function pilihNominal(idx) {
    const games = JSON.parse(localStorage.getItem(dbGamesKey)) || [];
    const game = games.find(g => g.id === currentOrderGameId);
    if (!game) return;
    selectedOrderItem = game.items[idx];
    document.getElementById('order-total-price').textContent = selectedOrderItem.price;

    document.querySelectorAll('.nominal-btn').forEach((btn, i) => {
        if (i === idx) {
            btn.classList.add('border-orange-500', 'bg-orange-500/10');
            btn.classList.remove('border-appBorder');
        } else {
            btn.classList.remove('border-orange-500', 'bg-orange-500/10');
            btn.classList.add('border-appBorder');
        }
    });
}

async function prosesCheckout(e) {
    e.preventDefault();
    if (!selectedOrderItem) {
        showToast('Pilih nominal item terlebih dahulu!');
        return;
    }

    const userid = document.getElementById('order-userid').value.trim();
    const zoneid = document.getElementById('order-zoneid').value.trim();
    const whatsapp = document.getElementById('order-whatsapp').value.trim();
    const payment = document.getElementById('order-payment-method').value;
    const proofFile = document.getElementById('order-proof-file').files[0];
    const session = JSON.parse(localStorage.getItem(dbCurrentSessionKey));

    if (!userid || !whatsapp) {
        showToast('User ID dan WhatsApp wajib diisi!');
        return;
    }

    // Saldo member check
    if (payment.includes('Saldo Member')) {
        if (!session) {
            showToast('Login dulu untuk pakai saldo member!');
            return;
        }
        const price = parsePrice(selectedOrderItem.price);
        if ((session.balance || 0) < price) {
            showToast('Saldo member tidak cukup!');
            return;
        }
    } else if (!proofFile) {
        showToast('Upload bukti pembayaran wajib!');
        return;
    }

    let proofBase64 = '';
    if (proofFile) proofBase64 = await convertFileToBase64(proofFile);

    const games = JSON.parse(localStorage.getItem(dbGamesKey)) || [];
    const game = games.find(g => g.id === currentOrderGameId);
    const trxId = 'TRX-' + Date.now().toString().slice(-8);

    const transaction = {
        id: trxId,
        type: 'topup',
        gameId: currentOrderGameId,
        gameTitle: game.title,
        itemName: selectedOrderItem.name,
        price: selectedOrderItem.price,
        priceNum: parsePrice(selectedOrderItem.price),
        userid, zoneid, whatsapp, payment,
        proof: proofBase64,
        status: payment.includes('Saldo Member') ? 'success' : 'pending',
        createdAt: new Date().toISOString(),
        username: session ? session.username : 'guest'
    };

    // Deduct balance if using member saldo
    if (payment.includes('Saldo Member') && session) {
        let users = JSON.parse(localStorage.getItem(dbUsersKey)) || [];
        const idx = users.findIndex(u => u.username === session.username);
        if (idx >= 0) {
            users[idx].balance = (users[idx].balance || 0) - parsePrice(selectedOrderItem.price);
            // Count starlight for spin
            if (selectedOrderItem.name.toLowerCase().includes('starlight')) {
                users[idx].starlightCount = (users[idx].starlightCount || 0) + 1;
            }
            localStorage.setItem(dbUsersKey, JSON.stringify(users));
            session.balance = users[idx].balance;
            session.starlightCount = users[idx].starlightCount;
            localStorage.setItem(dbCurrentSessionKey, JSON.stringify(session));
        }
    } else {
        localStorage.setItem(dbNotifKey, 'true');
    }

    let trans = JSON.parse(localStorage.getItem(dbTransKey)) || [];
    trans.unshift(transaction);
    localStorage.setItem(dbTransKey, JSON.stringify(trans));

    if (!payment.includes('Saldo Member')) {
        localStorage.setItem(dbNotifKey, 'true');
        localStorage.setItem('s88_notif_trigger', Date.now().toString());
    }

    showSuccessModal(
        transaction.status === 'success' ? 'Pembayaran Berhasil!' : 'Pesanan Terkirim!',
        transaction.status === 'success'
            ? 'Saldo member berhasil dipotong. Pesanan sedang diproses.'
            : 'Bukti pembayaran berhasil dikirim. Admin akan segera memverifikasi pesanan Anda.',
        'ID: ' + trxId
    );
    setTimeout(() => {
        switchView('lacak');
        document.getElementById('search-trx-input').value = trxId;
        setTimeout(() => cariPesananTrack(), 300);
    }, 1500);
    updateNotifUI();
}

/* ===================== TRACK ORDER ===================== */
function cariPesananTrack() {
    const q = document.getElementById('search-trx-input').value.trim().toLowerCase();
    const container = document.getElementById('lacak-result-container');
    if (!q) {
        container.innerHTML = '<p class="text-xs text-appMuted text-center py-4">Masukkan ID TRX atau No WA</p>';
        return;
    }

    const trans = JSON.parse(localStorage.getItem(dbTransKey)) || [];
    const results = trans.filter(t =>
        t.id.toLowerCase().includes(q) ||
        String(t.whatsapp).includes(q)
    );

    if (results.length === 0) {
        container.innerHTML = '<div class="bg-appCard border border-appBorder rounded-2xl p-5 text-center text-xs text-appMuted">Tidak ditemukan transaksi.</div>';
        return;
    }

    container.innerHTML = results.map(t => {
        const statusColor = t.status === 'success' ? 'text-emerald-500' : t.status === 'rejected' ? 'text-red-500' : 'text-amber-500';
        const statusBg = t.status === 'success' ? 'bg-emerald-500/15 border-emerald-500/30' : t.status === 'rejected' ? 'bg-red-500/15 border-red-500/30' : 'bg-amber-500/15 border-amber-500/30';
        return `
        <div class="bg-appCard border border-appBorder rounded-2xl p-4 space-y-2 shadow-md">
            <div class="flex justify-between items-start">
                <div>
                    <p class="font-bold text-xs text-appText">${t.id}</p>
                    <p class="text-[10px] text-appMuted">${new Date(t.createdAt).toLocaleString('id-ID')}</p>
                </div>
                <span class="text-[9px] font-bold uppercase px-2 py-0.5 rounded border ${statusBg} ${statusColor}">${t.status}</span>
            </div>
            <div class="text-[11px] space-y-0.5">
                <p><span class="text-appMuted">Game:</span> <b>${t.gameTitle}</b></p>
                <p><span class="text-appMuted">Item:</span> ${t.itemName}</p>
                <p><span class="text-appMuted">User ID:</span> ${t.userid}${t.zoneid ? ' (' + t.zoneid + ')' : ''}</p>
                <p><span class="text-appMuted">WA:</span> ${t.whatsapp}</p>
                <p><span class="text-appMuted">Bayar:</span> ${t.payment} — <b class="text-orange-500">${t.price}</b></p>
            </div>
            ${t.proof ? `<button onclick="lihatBukti('${t.proof.replace(/'/g, "\\'")}')" class="text-[10px] text-indigo-500 font-bold"><i class="fas fa-image"></i> Lihat Bukti Transfer</button>` : ''}
        </div>`;
    }).join('');
}

